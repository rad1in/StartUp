# Mobile app environment variables.
# Copy to .env and fill in before an EAS/production build. In local dev
# (Expo Go / dev client) these can stay blank — the app derives the API host
# automatically from the Metro dev server's LAN IP instead. A real
# production build has no dev server, so these MUST be set before building,
# or the app will try to reach "localhost" on the user's own phone.

# This backend's public API URL, including the /api prefix.
EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api

# This backend's public base URL for serving uploaded files (no /api suffix).
EXPO_PUBLIC_UPLOADS_URL=https://api.yourdomain.com

# The customer-facing web app's URL — used for things the mobile app opens
# in an in-app browser rather than duplicating natively (e.g. legal pages).
EXPO_PUBLIC_WEB_URL=https://yourdomain.com

# Sentry crash/error monitoring — leave blank to disable.
EXPO_PUBLIC_SENTRY_DSN=
