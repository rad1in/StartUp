# Frontend environment variables
# Copy this file to .env and fill in real values before running the dev server.

# Backend API base URL
VITE_API_URL=http://localhost:4000/api

# Socket.IO server URL (usually same host as the backend, without /api)
VITE_SOCKET_URL=http://localhost:4000

# Neshan maps/geolocation API key (https://platform.neshan.org) — placeholder
VITE_NESHAN_API_KEY=your-neshan-api-key

# Google Sign-In OAuth client ID (same value as backend GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=

# Public site URL (no trailing slash) — used for canonical links and Open
# Graph/Twitter card tags in index.html. Set to the real production domain
# before deploying; falls back to a relative "/" during local dev.
VITE_SITE_URL=

# Sentry crash/error monitoring — leave blank to disable.
VITE_SENTRY_DSN=
