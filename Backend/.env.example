# Backend environment variables
# Copy this file to .env and fill in real values before running the server.
# Every variable actually read anywhere in src/ is listed here — nothing
# left out. Group by what part of the app it configures.

# ── Database ─────────────────────────────────────────────────────────────
# MySQL/MariaDB connection (used by mysql2 directly — no ORM/connection string)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=qr_ordering

# ── Server ───────────────────────────────────────────────────────────────
# HTTP port the Express server listens on
PORT=4000
NODE_ENV=development

# Optional: terminate TLS directly in Node instead of at a reverse proxy.
# Leave SSL_ENABLED=false (the default) when a proxy/load balancer in front
# of this process already handles HTTPS — that's the normal production setup.
SSL_ENABLED=false
SSL_KEY_PATH=
SSL_CERT_PATH=
SSL_CA_PATH=

# Rate limiting (env-tunable so ops can adjust per deployment without a
# redeploy). Defaults: general API 600 req/min/IP, auth endpoints 20 req/15min/IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ── Secrets (use long, random strings in production — the server refuses to
#    boot with the placeholder values below when NODE_ENV=production) ──────
JWT_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
TICKET_ENCRYPTION_KEY="replace-with-a-long-random-encryption-key"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Public URLs / CORS ───────────────────────────────────────────────────
# Exact origins (scheme + host, no path) allowed to call the API from a
# browser and connect via Socket.IO. Comma-separated — list every real
# frontend origin you serve in production (e.g. the customer web app and,
# if hosted on a separate subdomain, the admin panel). This does NOT
# restrict which visitor IPs can reach the API — CORS only governs which
# *website origins* a browser will let call this API; native mobile app
# requests send no Origin header at all and are unaffected either way.
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
SOCKET_CORS_ORIGIN=http://localhost:5173
# Public web frontend origin — used to build absolute URLs (sitemap,
# payment-gateway redirect targets, notification links).
SITE_URL=http://localhost:5173
# This backend's own public API URL — used by gateways (like Saman/SEP)
# that POST their callback straight to a server endpoint rather than
# redirecting the browser to a frontend page (AqayePardakht's flow).
API_URL=http://localhost:5000/api

# ── Payments ─────────────────────────────────────────────────────────────
# No env var here — there is no mock/simulated gateway. The enabled real
# gateway(s) and their credentials are set live via the admin Integrations
# page (ZarinPal and AqayePardakht both support a sandbox toggle there for
# testing without moving real money).

# ── SMS ──────────────────────────────────────────────────────────────────
# "mock" (dev — logs the OTP code to the console) or "melipayamak" (real
# SMS via console.melipayamak.com). Melipayamak token is also settable live
# via the admin Integrations page — this env var is only the fallback.
SMS_PROVIDER=mock
# Melipayamak account token — the <token> segment of the send/otp/<token> URL.
MELIPAYAMAK_OTP_TOKEN=

# ── Email ────────────────────────────────────────────────────────────────
# "mock" (dev — logs to console) or "smtp" (real email via any SMTP
# account). Actual SMTP host/user/pass are set via the admin Integrations
# page; this is just the fallback default.
EMAIL_PROVIDER=mock

# ── Maps (Neshan — https://platform.neshan.org) ─────────────────────────
NESHAN_API_KEY=your-neshan-api-key
# Neshan "service" key for the server-side Static Map / geocoding REST API
# (separate from the API key above, format: service.xxxxxx).
NESHAN_SERVICE_KEY=

# ── AI auto-translation (GapGPT — https://gapgpt.app, OpenAI-compatible) ─
# Silently translates venue-owner-entered Persian content (menu items,
# categories, venue profile) into the platform's other customer-facing
# languages. Leave GAPGPT_API_KEY blank to disable — content simply stays
# Persian-only for customers who pick another language.
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-4o

# ── Crash/error monitoring (Sentry) ──────────────────────────────────────
# Leave blank to disable entirely (no requests are ever made without a DSN).
SENTRY_DSN=

# ── CDN / WAF (Parspack — https://my.parspack.com) ────────────────────────
# Powers the admin panel's read-only "CDN Protection" status card and the
# one-off scripts/configureCdnSecurity.js script. Leave blank to disable —
# nothing calls Parspack's API without both of these set.
PARSPACK_CDN_API_KEY=
PARSPACK_CDN_ZONE_UUID=

# ── Google Sign-In ───────────────────────────────────────────────────────
# OAuth 2.0 Web client ID from Google Cloud Console. Required for "ورود با
# گوگل"; leave blank to disable audience verification in dev.
GOOGLE_CLIENT_ID=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
# The frontend fetches the public key from the backend at runtime (GET
# /api/push/vapid-public-key or similar) — no matching frontend env var needed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# ── Loyalty ──────────────────────────────────────────────────────────────
# Points earned per 10,000 Toman spent when a venue doesn't set its own rate.
LOYALTY_DEFAULT_POINTS_RATE=1
# Toman value of a single redeemed loyalty point.
LOYALTY_POINT_VALUE=1000

# ── Storage ──────────────────────────────────────────────────────────────
# Local directory for uploaded files (avatars, menu item images, logos, etc.)
UPLOAD_DIR=uploads
# Local directory the automated database backup job writes .sql dumps into.
BACKUP_DIR=backups
# Absolute paths to the mysqldump/mysql CLI binaries used by the backup
# module. Defaults below assume a local XAMPP install on Windows — on
# Linux/macOS (and any real production server) set these to wherever
# mysqldump/mysql actually live, e.g. "mysqldump" and "mysql" if they're
# already on PATH, or "/usr/bin/mysqldump" and "/usr/bin/mysql".
MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
MYSQL_CLI_PATH=C:\xampp\mysql\bin\mysql.exe
